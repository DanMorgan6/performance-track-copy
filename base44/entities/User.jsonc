{
  "name": "User",
  "properties": {
    "booking_enabled": {
      "default": false,
      "description": "Whether clinician booking is enabled",
      "type": "boolean"
    },
    "booking_url": {
      "description": "External booking system URL",
      "type": "string"
    },
    "clinic_id": {
      "description": "Reference to Clinic - assigned only by trusted backend functions",
      "type": "string",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "job_title": {
      "description": "Job title (for clinicians)",
      "type": "string"
    },
    "onboarding_completed": {
      "default": false,
      "description": "Whether user has completed onboarding",
      "type": "boolean"
    },
    "patient_id": {
      "description": "Reference to the linked Patient record for patient users",
      "type": "string",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "role": {
      "default": "patient",
      "description": "User role in the system; assigned only by trusted backend functions",
      "enum": [
        "clinic_admin",
        "clinician",
        "patient",
        "admin"
      ],
      "type": "string",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "specialties": {
      "description": "Professional specialties (for clinicians)",
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [],
  "rls": {
    "create": false,
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "$and": [
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "clinic_admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "clinician"
                  }
                }
              ]
            },
            {
              "data.clinic_id": "{{user.data.clinic_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "$and": [
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "clinic_admin"
                  }
                }
              ]
            },
            {
              "data.clinic_id": "{{user.data.clinic_id}}"
            }
          ]
        }
      ]
    }
  },
  "type": "object"
}