{
  "name": "User",
  "properties": {
    "booking_enabled": {
      "default": false,
      "description": "Whether clinician booking is enabled",
      "type": "boolean"
    },
    "booking_url": {
      "description": "External booking system URL",
      "type": "string"
    },
    "clinic_id": {
      "description": "Reference to Clinic - required for clinic_admin and clinician roles",
      "type": "string"
    },
    "job_title": {
      "description": "Job title (for clinicians)",
      "type": "string"
    },
    "onboarding_completed": {
      "default": false,
      "description": "Whether user has completed onboarding",
      "type": "boolean"
    },
    "patient_id": {
      "description": "Reference to the linked Patient record for patient users",
      "type": "string"
    },
    "role": {
      "default": "patient",
      "description": "User role in the system",
      "enum": [
        "clinic_admin",
        "clinician",
        "patient",
        "admin"
      ],
      "type": "string"
    },
    "specialties": {
      "description": "Professional specialties (for clinicians)",
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "clinic_id",
    "job_title",
    "specialties",
    "booking_url"
  ],
  "type": "object"
}