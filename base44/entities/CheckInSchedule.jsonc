{
  "name": "CheckInSchedule",
  "properties": {
    "clinic_id": {
      "description": "Reference to Clinic - clinic-level default",
      "type": "string"
    },
    "clinician_email": {
      "description": "Clinician email - clinician override (optional)",
      "type": "string"
    },
    "days_of_week": {
      "description": "Days when check-in is due",
      "items": {
        "enum": [
          "Monday",
          "Tuesday",
          "Wednesday",
          "Thursday",
          "Friday",
          "Saturday",
          "Sunday"
        ],
        "type": "string"
      },
      "type": "array"
    },
    "enabled": {
      "default": true,
      "description": "Whether this schedule is active",
      "type": "boolean"
    },
    "patient_id": {
      "description": "Reference to Patient - patient override (optional)",
      "type": "string"
    },
    "schedule_type": {
      "default": "clinic",
      "description": "Which level this schedule applies to",
      "enum": [
        "clinic",
        "clinician",
        "patient"
      ],
      "type": "string"
    },
    "time_of_day": {
      "description": "Preferred time (e.g., '09:00')",
      "type": "string"
    }
  },
  "required": [
    "clinic_id",
    "days_of_week"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "clinic_admin"
              }
            },
            {
              "user_condition": {
                "role": "clinician"
              }
            }
          ]
        },
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "clinic_admin"
              }
            },
            {
              "user_condition": {
                "role": "clinician"
              }
            }
          ]
        },
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        }
      ]
    },
    "read": {
      "data.clinic_id": "{{user.data.clinic_id}}"
    },
    "update": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "clinic_admin"
              }
            },
            {
              "user_condition": {
                "role": "clinician"
              }
            }
          ]
        },
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        }
      ]
    }
  },
  "type": "object"
}