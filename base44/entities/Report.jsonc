{
  "name": "Report",
  "properties": {
    "clinic_id": {
      "description": "Reference to Clinic",
      "type": "string"
    },
    "clinician_email": {
      "description": "Clinician associated with a generated report",
      "type": "string"
    },
    "created_by": {
      "description": "Email of clinician who uploaded",
      "type": "string"
    },
    "date": {
      "description": "Date of report",
      "format": "date",
      "type": "string"
    },
    "file_uri": {
      "description": "Private file URI for secure access",
      "type": "string"
    },
    "file_url": {
      "description": "URL to uploaded PDF report",
      "type": "string"
    },
    "frequency": {
      "description": "Generated report frequency",
      "enum": [
        "on_demand",
        "weekly",
        "bi-weekly",
        "monthly"
      ],
      "type": "string"
    },
    "generated_date": {
      "description": "Date the analytics report was generated",
      "format": "date",
      "type": "string"
    },
    "notes": {
      "description": "Clinician notes about the report",
      "type": "string"
    },
    "patient_id": {
      "description": "Reference to Patient",
      "type": "string"
    },
    "period_end": {
      "format": "date",
      "type": "string"
    },
    "period_start": {
      "format": "date",
      "type": "string"
    },
    "report_data": {
      "description": "Structured generated report metrics",
      "type": "object"
    },
    "report_type": {
      "description": "Generated analytics report type",
      "enum": [
        "patient_progress",
        "clinician_performance"
      ],
      "type": "string"
    },
    "type": {
      "description": "Report type",
      "enum": [
        "medical_history",
        "imaging",
        "lab_results",
        "imaging_report",
        "surgery_report",
        "consultation",
        "other"
      ],
      "type": "string"
    },
    "visible_to_patient": {
      "default": false,
      "description": "Whether patient can view this report",
      "type": "boolean"
    }
  },
  "required": [
    "clinic_id"
  ],
  "type": "object"
}