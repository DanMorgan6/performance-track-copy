{
  "name": "ClinicInvite",
  "properties": {
    "accepted_date": {
      "format": "date",
      "type": "string"
    },
    "clinic_id": {
      "description": "Reference to Clinic",
      "type": "string"
    },
    "email": {
      "description": "Email of invited clinician",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "type": "string"
    },
    "invite_code": {
      "description": "Unique token for accepting invite",
      "type": "string"
    },
    "role": {
      "default": "clinician",
      "description": "Role to assign upon acceptance",
      "enum": [
        "clinic_admin",
        "clinician",
        "admin"
      ],
      "type": "string"
    },
    "status": {
      "default": "pending",
      "enum": [
        "pending",
        "accepted",
        "expired"
      ],
      "type": "string"
    }
  },
  "required": [
    "clinic_id",
    "email",
    "invite_code"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "clinic_admin"
              }
            }
          ]
        },
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "clinic_admin"
              }
            }
          ]
        },
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "$and": [
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "clinic_admin"
                  }
                }
              ]
            },
            {
              "data.clinic_id": "{{user.data.clinic_id}}"
            }
          ]
        },
        {
          "data.email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "clinic_admin"
                  }
                }
              ]
            },
            {
              "data.clinic_id": "{{user.data.clinic_id}}"
            }
          ]
        },
        {
          "data.email": "{{user.email}}"
        }
      ]
    }
  },
  "type": "object"
}