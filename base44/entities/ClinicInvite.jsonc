{
  "name": "ClinicInvite",
  "type": "object",
  "properties": {
    "clinic_id": {
      "type": "string",
      "description": "Reference to Clinic"
    },
    "email": {
      "type": "string",
      "description": "Email of invited clinician"
    },
    "invite_code": {
      "type": "string",
      "description": "Unique token for accepting invite"
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "clinician"
      ],
      "default": "clinician",
      "description": "Role to assign upon acceptance"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "expired"
      ],
      "default": "pending"
    },
    "accepted_date": {
      "type": "string",
      "format": "date"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "clinic_id",
    "email",
    "invite_code"
  ]
}