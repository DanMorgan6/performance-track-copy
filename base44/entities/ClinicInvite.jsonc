{
  "name": "ClinicInvite",
  "properties": {
    "accepted_date": {
      "format": "date",
      "type": "string"
    },
    "clinic_id": {
      "description": "Reference to Clinic",
      "type": "string"
    },
    "email": {
      "description": "Email of invited clinician",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "type": "string"
    },
    "invite_code": {
      "description": "Unique token for accepting invite",
      "type": "string"
    },
    "role": {
      "default": "clinician",
      "description": "Role to assign upon acceptance",
      "enum": [
        "clinic_admin",
        "clinician",
        "admin"
      ],
      "type": "string"
    },
    "status": {
      "default": "pending",
      "enum": [
        "pending",
        "accepted",
        "expired"
      ],
      "type": "string"
    }
  },
  "required": [
    "clinic_id",
    "email",
    "invite_code"
  ],
  "type": "object"
}