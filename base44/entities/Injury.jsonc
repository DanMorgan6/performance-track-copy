{
  "name": "Injury",
  "properties": {
    "clinic_id": {
      "description": "Reference to Clinic",
      "type": "string"
    },
    "confirmed_status": {
      "default": "suspected",
      "description": "Whether the injury is suspected or confirmed",
      "enum": [
        "suspected",
        "confirmed"
      ],
      "type": "string"
    },
    "date_of_injury": {
      "description": "Date of injury",
      "format": "date",
      "type": "string"
    },
    "group_key": {
      "description": "Group within the region (e.g., ligaments, tendon, muscle)",
      "type": "string"
    },
    "group_label": {
      "description": "Human-readable group label",
      "type": "string"
    },
    "issue_key": {
      "description": "Specific diagnosis key (e.g., acl_injury, rotator_cuff_tear)",
      "type": "string"
    },
    "issue_label": {
      "description": "Human-readable issue label",
      "type": "string"
    },
    "modifiers_data": {
      "description": "Additional structured data for this injury (muscle grading, disc details, meniscus details, etc.)",
      "type": "object"
    },
    "notes": {
      "description": "Clinician notes about the injury",
      "type": "string"
    },
    "patient_id": {
      "description": "Reference to Patient",
      "type": "string"
    },
    "region_key": {
      "description": "Region from the injury diagnosis library (e.g., foot_ankle, knee, shoulder)",
      "type": "string"
    },
    "region_label": {
      "description": "Human-readable region label",
      "type": "string"
    },
    "severity": {
      "description": "Severity level if applicable",
      "enum": [
        "irritation",
        "sprain",
        "partial_tear",
        "full_thickness_tear",
        "rupture"
      ],
      "type": "string"
    },
    "side": {
      "description": "Side of injury",
      "enum": [
        "left",
        "right",
        "bilateral",
        "midline"
      ],
      "type": "string"
    }
  },
  "required": [
    "clinic_id",
    "patient_id",
    "region_key",
    "issue_key",
    "side"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "clinic_admin"
              }
            },
            {
              "user_condition": {
                "role": "clinician"
              }
            }
          ]
        },
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "clinic_admin"
              }
            },
            {
              "user_condition": {
                "role": "clinician"
              }
            }
          ]
        },
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "$and": [
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "clinic_admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "clinician"
                  }
                }
              ]
            },
            {
              "data.clinic_id": "{{user.data.clinic_id}}"
            }
          ]
        },
        {
          "data.patient_id": "{{user.data.patient_id}}"
        }
      ]
    },
    "update": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "clinic_admin"
              }
            },
            {
              "user_condition": {
                "role": "clinician"
              }
            }
          ]
        },
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        }
      ]
    }
  },
  "type": "object"
}