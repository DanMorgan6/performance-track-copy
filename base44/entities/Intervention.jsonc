{
  "name": "Intervention",
  "properties": {
    "attachments": {
      "description": "Links to reports or files",
      "items": {
        "properties": {
          "file_name": {
            "type": "string"
          },
          "file_url": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "clinic_id": {
      "description": "Reference to Clinic",
      "type": "string"
    },
    "follow_up_date": {
      "description": "Optional follow-up date",
      "format": "date",
      "type": "string"
    },
    "intervention_date": {
      "description": "Date of intervention",
      "format": "date",
      "type": "string"
    },
    "intervention_time": {
      "description": "Optional time in HH:MM format",
      "type": "string"
    },
    "intervention_type": {
      "description": "Type of intervention",
      "enum": [
        "injection",
        "manipulation",
        "dry_needling",
        "taping",
        "mobilization",
        "soft_tissue_therapy",
        "shockwave_therapy",
        "other"
      ],
      "type": "string"
    },
    "location": {
      "description": "Body location where intervention was/will be performed",
      "type": "string"
    },
    "medication_or_details": {
      "description": "Medication name for injections or other details",
      "type": "string"
    },
    "notes": {
      "description": "Additional notes about the intervention",
      "type": "string"
    },
    "patient_id": {
      "description": "Reference to Patient",
      "type": "string"
    },
    "performed_by": {
      "description": "Clinician who performed/will perform the intervention",
      "type": "string"
    },
    "shockwave_energy": {
      "description": "Energy in mJ/mm\u00b2",
      "type": "string"
    },
    "shockwave_frequency": {
      "description": "Frequency in Hz",
      "type": "string"
    },
    "shockwave_impulses": {
      "description": "Number of impulses",
      "type": "string"
    },
    "shockwave_type": {
      "description": "Type of shockwave therapy (Focused or Radial)",
      "enum": [
        "focused",
        "radial"
      ],
      "type": "string"
    },
    "status": {
      "default": "planned",
      "description": "Intervention status",
      "enum": [
        "planned",
        "completed",
        "cancelled"
      ],
      "type": "string"
    },
    "title": {
      "description": "Optional intervention title",
      "type": "string"
    },
    "visible_to_patient": {
      "default": true,
      "description": "Whether patient can see this intervention",
      "type": "boolean"
    }
  },
  "required": [
    "clinic_id",
    "patient_id",
    "intervention_type",
    "intervention_date"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "clinic_admin"
              }
            },
            {
              "user_condition": {
                "role": "clinician"
              }
            }
          ]
        },
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "clinic_admin"
              }
            },
            {
              "user_condition": {
                "role": "clinician"
              }
            }
          ]
        },
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "$and": [
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "clinic_admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "clinician"
                  }
                }
              ]
            },
            {
              "data.clinic_id": "{{user.data.clinic_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "$and": [
                {
                  "data.patient_id": "{{user.data.patient_id}}"
                },
                {
                  "data.clinic_id": "{{user.data.clinic_id}}"
                }
              ]
            },
            {
              "data.visible_to_patient": true
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "clinic_admin"
              }
            },
            {
              "user_condition": {
                "role": "clinician"
              }
            }
          ]
        },
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        }
      ]
    }
  },
  "type": "object"
}