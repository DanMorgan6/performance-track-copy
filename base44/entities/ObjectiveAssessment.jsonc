{
  "name": "ObjectiveAssessment",
  "properties": {
    "assessment_date": {
      "format": "date",
      "type": "string"
    },
    "assessment_type": {
      "description": "Type of assessment",
      "enum": [
        "strength",
        "range_of_motion",
        "functional_test",
        "balance",
        "endurance",
        "flexibility",
        "other"
      ],
      "type": "string"
    },
    "baseline": {
      "description": "Baseline or comparison value",
      "type": "string"
    },
    "body_part": {
      "description": "Body part being assessed",
      "type": "string"
    },
    "clinic_id": {
      "description": "Reference to Clinic for tenant isolation",
      "type": "string"
    },
    "clinician_name": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "patient_id": {
      "description": "Reference to Patient",
      "type": "string"
    },
    "side": {
      "default": "n/a",
      "enum": [
        "left",
        "right",
        "bilateral",
        "n/a"
      ],
      "type": "string"
    },
    "test_name": {
      "description": "Name of the test or measurement",
      "type": "string"
    },
    "unit": {
      "description": "Unit of measurement (kg, degrees, seconds, etc)",
      "type": "string"
    },
    "value": {
      "description": "Measurement value",
      "type": "string"
    }
  },
  "required": [
    "patient_id",
    "assessment_date",
    "test_name"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "clinic_admin"
              }
            },
            {
              "user_condition": {
                "role": "clinician"
              }
            }
          ]
        },
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "clinic_admin"
              }
            },
            {
              "user_condition": {
                "role": "clinician"
              }
            }
          ]
        },
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "$and": [
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "clinic_admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "clinician"
                  }
                }
              ]
            },
            {
              "data.clinic_id": "{{user.data.clinic_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "data.patient_id": "{{user.data.patient_id}}"
            },
            {
              "data.clinic_id": "{{user.data.clinic_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "clinic_admin"
              }
            },
            {
              "user_condition": {
                "role": "clinician"
              }
            }
          ]
        },
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        }
      ]
    }
  },
  "type": "object"
}