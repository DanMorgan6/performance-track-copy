{
  "name": "ObjectiveAssessment",
  "properties": {
    "assessment_date": {
      "format": "date",
      "type": "string"
    },
    "assessment_type": {
      "description": "Type of assessment",
      "enum": [
        "strength",
        "range_of_motion",
        "functional_test",
        "balance",
        "endurance",
        "flexibility",
        "other"
      ],
      "type": "string"
    },
    "baseline": {
      "description": "Baseline or comparison value",
      "type": "string"
    },
    "body_part": {
      "description": "Body part being assessed",
      "type": "string"
    },
    "clinic_id": {
      "description": "Reference to Clinic for tenant isolation",
      "type": "string"
    },
    "clinician_name": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "patient_id": {
      "description": "Reference to Patient",
      "type": "string"
    },
    "side": {
      "default": "n/a",
      "enum": [
        "left",
        "right",
        "bilateral",
        "n/a"
      ],
      "type": "string"
    },
    "test_name": {
      "description": "Name of the test or measurement",
      "type": "string"
    },
    "unit": {
      "description": "Unit of measurement (kg, degrees, seconds, etc)",
      "type": "string"
    },
    "value": {
      "description": "Measurement value",
      "type": "string"
    }
  },
  "required": [
    "patient_id",
    "assessment_date",
    "test_name"
  ],
  "type": "object"
}