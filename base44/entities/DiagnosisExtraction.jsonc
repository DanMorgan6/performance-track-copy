{
  "name": "DiagnosisExtraction",
  "properties": {
    "applied_date": {
      "format": "date",
      "type": "string"
    },
    "approved_by": {
      "description": "Email of clinician who approved",
      "type": "string"
    },
    "approved_date": {
      "format": "date",
      "type": "string"
    },
    "clinic_id": {
      "description": "Reference to Clinic",
      "type": "string"
    },
    "created_by": {
      "description": "Email of clinician who initiated extraction",
      "type": "string"
    },
    "extraction_data": {
      "description": "Array of extracted diagnoses",
      "items": {
        "properties": {
          "ai_confidence": {
            "description": "0-100 confidence score from AI",
            "type": "number"
          },
          "clinician_edited": {
            "default": false,
            "type": "boolean"
          },
          "issue_key": {
            "description": "Issue/diagnosis key from injury library",
            "type": "string"
          },
          "issue_label": {
            "type": "string"
          },
          "modifiers_data": {
            "type": "object"
          },
          "region_key": {
            "description": "Region key from injury library",
            "type": "string"
          },
          "region_label": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "side": {
            "enum": [
              "left",
              "right",
              "bilateral",
              "midline"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "patient_id": {
      "description": "Reference to Patient",
      "type": "string"
    },
    "report_id": {
      "description": "Reference to Report",
      "type": "string"
    },
    "status": {
      "default": "pending_review",
      "description": "Status of this extraction",
      "enum": [
        "pending_review",
        "approved",
        "applied",
        "rejected"
      ],
      "type": "string"
    }
  },
  "required": [
    "clinic_id",
    "patient_id",
    "report_id"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "clinic_admin"
              }
            },
            {
              "user_condition": {
                "role": "clinician"
              }
            }
          ]
        },
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "clinic_admin"
              }
            },
            {
              "user_condition": {
                "role": "clinician"
              }
            }
          ]
        },
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        }
      ]
    },
    "read": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "clinic_admin"
              }
            },
            {
              "user_condition": {
                "role": "clinician"
              }
            }
          ]
        },
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        }
      ]
    },
    "update": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "clinic_admin"
              }
            },
            {
              "user_condition": {
                "role": "clinician"
              }
            }
          ]
        },
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        }
      ]
    }
  },
  "type": "object"
}