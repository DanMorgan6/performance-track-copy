{
  "name": "WearableDailySummary",
  "type": "object",
  "properties": {
    "clinic_id": {
      "type": "string",
      "description": "Owning clinic for tenant isolation"
    },
    "patient_id": {
      "type": "string"
    },
    "provider": {
      "type": "string",
      "enum": [
        "apple_health",
        "health_connect",
        "garmin",
        "fitbit",
        "manual",
        "other"
      ]
    },
    "summary_date": {
      "type": "string",
      "format": "date"
    },
    "steps": {
      "type": "number"
    },
    "active_minutes": {
      "type": "number"
    },
    "running_minutes": {
      "type": "number"
    },
    "distance_km": {
      "type": "number"
    },
    "elevation_gain_m": {
      "type": "number"
    },
    "sleep_minutes": {
      "type": "number"
    },
    "resting_heart_rate": {
      "type": "number"
    },
    "hrv_ms": {
      "type": "number"
    },
    "stress_score": {
      "type": "number"
    },
    "recovery_score": {
      "type": "number"
    },
    "average_heart_rate": {
      "type": "number"
    },
    "high_intensity_minutes": {
      "type": "number"
    },
    "patient_rpe": {
      "type": "number"
    },
    "symptom_score": {
      "type": "number"
    },
    "source_record_count": {
      "type": "number"
    },
    "synced_at": {
      "type": "string",
      "format": "date-time"
    },
    "clinician_note": {
      "type": "string"
    }
  },
  "required": [
    "clinic_id",
    "patient_id",
    "provider",
    "summary_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "$and": [
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "clinic_admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "clinician"
                  }
                }
              ]
            },
            {
              "data.clinic_id": "{{user.data.clinic_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "data.patient_id": "{{user.data.patient_id}}"
            },
            {
              "data.clinic_id": "{{user.data.clinic_id}}"
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "$and": [
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "clinic_admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "clinician"
                  }
                }
              ]
            },
            {
              "data.clinic_id": "{{user.data.clinic_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "data.patient_id": "{{user.data.patient_id}}"
            },
            {
              "data.clinic_id": "{{user.data.clinic_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "clinic_admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "clinician"
                  }
                }
              ]
            },
            {
              "data.clinic_id": "{{user.data.clinic_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "data.patient_id": "{{user.data.patient_id}}"
            },
            {
              "data.clinic_id": "{{user.data.clinic_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "clinic_admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "clinician"
                  }
                }
              ]
            },
            {
              "data.clinic_id": "{{user.data.clinic_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "data.patient_id": "{{user.data.patient_id}}"
            },
            {
              "data.clinic_id": "{{user.data.clinic_id}}"
            }
          ]
        }
      ]
    }
  }
}