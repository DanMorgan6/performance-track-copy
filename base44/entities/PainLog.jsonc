{
  "name": "PainLog",
  "properties": {
    "activity_context": {
      "description": "What was the patient doing",
      "type": "string"
    },
    "clinic_id": {
      "description": "Reference to Clinic for tenant isolation",
      "type": "string"
    },
    "date": {
      "format": "date",
      "type": "string"
    },
    "medication_taken": {
      "default": false,
      "type": "boolean"
    },
    "notes": {
      "type": "string"
    },
    "pain_level": {
      "description": "Pain scale 0-10",
      "type": "number"
    },
    "pain_location": {
      "type": "string"
    },
    "pain_type": {
      "enum": [
        "sharp",
        "dull",
        "aching",
        "burning",
        "throbbing",
        "stabbing",
        "other"
      ],
      "type": "string"
    },
    "patient_id": {
      "type": "string"
    },
    "time_of_day": {
      "enum": [
        "morning",
        "afternoon",
        "evening",
        "night"
      ],
      "type": "string"
    }
  },
  "required": [
    "patient_id",
    "date",
    "pain_level"
  ],
  "type": "object"
}