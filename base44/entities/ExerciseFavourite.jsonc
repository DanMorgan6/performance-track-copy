{
  "name": "ExerciseFavourite",
  "properties": {
    "added_by": {
      "description": "Email of clinician who added to favorites",
      "type": "string"
    },
    "clinic_id": {
      "description": "Reference to Clinic - for clinic-wide recommendations",
      "type": "string"
    },
    "exercise_library_id": {
      "description": "Reference to ExerciseLibrary",
      "type": "string"
    },
    "notes": {
      "description": "Internal notes about why this is a favorite",
      "type": "string"
    },
    "usage_count": {
      "default": 0,
      "description": "Number of times used in plans",
      "type": "number"
    }
  },
  "required": [
    "clinic_id",
    "exercise_library_id"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "clinic_admin"
              }
            },
            {
              "user_condition": {
                "role": "clinician"
              }
            }
          ]
        },
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "clinic_admin"
              }
            },
            {
              "user_condition": {
                "role": "clinician"
              }
            }
          ]
        },
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        }
      ]
    },
    "read": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "clinic_admin"
              }
            },
            {
              "user_condition": {
                "role": "clinician"
              }
            }
          ]
        },
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        }
      ]
    },
    "update": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "clinic_admin"
              }
            },
            {
              "user_condition": {
                "role": "clinician"
              }
            }
          ]
        },
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        }
      ]
    }
  },
  "type": "object"
}