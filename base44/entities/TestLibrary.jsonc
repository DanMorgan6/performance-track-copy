{
  "name": "TestLibrary",
  "type": "object",
  "properties": {
    "clinic_id": {
      "type": "string",
      "description": "Reference to Clinic - for clinic-specific tests"
    },
    "name": {
      "type": "string",
      "description": "Test name"
    },
    "category": {
      "type": "string",
      "enum": [
        "strength",
        "endurance",
        "balance",
        "rom",
        "hop_test",
        "functional",
        "other"
      ],
      "description": "Test category"
    },
    "description": {
      "type": "string"
    },
    "unit": {
      "type": "string",
      "description": "Measurement unit (e.g., kg, degrees, seconds)"
    },
    "benchmark_reference": {
      "type": "string",
      "description": "Reference benchmark values"
    },
    "is_global": {
      "type": "boolean",
      "default": false,
      "description": "Available to all clinics"
    }
  },
  "required": [
    "name",
    "category"
  ]
}