{
  "name": "TestLibrary",
  "properties": {
    "benchmark_reference": {
      "description": "Reference benchmark values",
      "type": "string"
    },
    "category": {
      "description": "Test category",
      "enum": [
        "strength",
        "endurance",
        "balance",
        "rom",
        "hop_test",
        "functional",
        "other"
      ],
      "type": "string"
    },
    "clinic_id": {
      "description": "Reference to Clinic - for clinic-specific tests",
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "is_global": {
      "default": false,
      "description": "Available to all clinics",
      "type": "boolean"
    },
    "name": {
      "description": "Test name",
      "type": "string"
    },
    "unit": {
      "description": "Measurement unit (e.g., kg, degrees, seconds)",
      "type": "string"
    }
  },
  "required": [
    "name",
    "category"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "clinic_admin"
              }
            },
            {
              "user_condition": {
                "role": "clinician"
              }
            }
          ]
        },
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "clinic_admin"
              }
            },
            {
              "user_condition": {
                "role": "clinician"
              }
            }
          ]
        },
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        },
        {
          "data.is_global": true
        }
      ]
    },
    "update": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "clinic_admin"
              }
            },
            {
              "user_condition": {
                "role": "clinician"
              }
            }
          ]
        },
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        }
      ]
    }
  },
  "type": "object"
}