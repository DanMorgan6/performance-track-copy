{
  "name": "CheckInScheduleConfig",
  "properties": {
    "clinic_id": {
      "description": "Reference to Clinic - clinic default schedule",
      "type": "string"
    },
    "days_of_week": {
      "description": "Days when check-in is due",
      "items": {
        "enum": [
          "Monday",
          "Tuesday",
          "Wednesday",
          "Thursday",
          "Friday",
          "Saturday",
          "Sunday"
        ],
        "type": "string"
      },
      "type": "array"
    },
    "enabled": {
      "default": true,
      "description": "Whether check-in reminders are active",
      "type": "boolean"
    },
    "reminder_hours_before": {
      "default": 12,
      "description": "Hours before scheduled time to send reminder",
      "type": "number"
    },
    "time_of_day": {
      "description": "Preferred time in HH:MM format (e.g., 09:00)",
      "type": "string"
    }
  },
  "required": [
    "clinic_id",
    "days_of_week",
    "time_of_day"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "clinic_admin"
              }
            },
            {
              "user_condition": {
                "role": "clinician"
              }
            }
          ]
        },
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "clinic_admin"
              }
            },
            {
              "user_condition": {
                "role": "clinician"
              }
            }
          ]
        },
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        }
      ]
    },
    "read": {
      "data.clinic_id": "{{user.data.clinic_id}}"
    },
    "update": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "clinic_admin"
              }
            },
            {
              "user_condition": {
                "role": "clinician"
              }
            }
          ]
        },
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        }
      ]
    }
  },
  "type": "object"
}