{
  "name": "MorningCheckIn",
  "type": "object",
  "properties": {
    "clinic_id": {
      "type": "string",
      "description": "Owning clinic for tenant isolation"
    },
    "patient_id": {
      "type": "string",
      "description": "Patient completing the daily check-in"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "morning_symptoms": {
      "type": "number",
      "minimum": 0,
      "maximum": 10
    },
    "fatigue": {
      "type": "number",
      "minimum": 0,
      "maximum": 10
    },
    "recovery": {
      "type": "number",
      "minimum": 0,
      "maximum": 10
    },
    "sleep_quality": {
      "type": "number",
      "minimum": 0,
      "maximum": 10
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "clinic_id",
    "patient_id",
    "date",
    "morning_symptoms",
    "fatigue",
    "recovery"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "$and": [
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "clinic_admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "clinician"
                  }
                }
              ]
            },
            {
              "data.clinic_id": "{{user.data.clinic_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "data.patient_id": "{{user.data.patient_id}}"
            },
            {
              "data.clinic_id": "{{user.data.clinic_id}}"
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "$and": [
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "clinic_admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "clinician"
                  }
                }
              ]
            },
            {
              "data.clinic_id": "{{user.data.clinic_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "data.patient_id": "{{user.data.patient_id}}"
            },
            {
              "data.clinic_id": "{{user.data.clinic_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "clinic_admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "clinician"
                  }
                }
              ]
            },
            {
              "data.clinic_id": "{{user.data.clinic_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "data.patient_id": "{{user.data.patient_id}}"
            },
            {
              "data.clinic_id": "{{user.data.clinic_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "clinic_admin"
              }
            },
            {
              "user_condition": {
                "role": "clinician"
              }
            }
          ]
        },
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        }
      ]
    }
  }
}