{
  "name": "PatientOutcomeMeasure",
  "properties": {
    "clinic_id": {
      "description": "Reference to Clinic for tenant isolation",
      "type": "string"
    },
    "completed_date": {
      "format": "date",
      "type": "string"
    },
    "frequency": {
      "default": "one-time",
      "description": "How often this outcome measure should be sent",
      "enum": [
        "one-time",
        "weekly",
        "bi-weekly",
        "monthly"
      ],
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "outcome_measure_id": {
      "description": "Reference to OutcomeMeasure",
      "type": "string"
    },
    "patient_id": {
      "description": "Reference to Patient",
      "type": "string"
    },
    "responses": {
      "items": {
        "properties": {
          "answer": {
            "type": "string"
          },
          "question_index": {
            "type": "number"
          },
          "score": {
            "type": "number"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "sent_date": {
      "format": "date",
      "type": "string"
    },
    "status": {
      "default": "pending",
      "enum": [
        "pending",
        "completed"
      ],
      "type": "string"
    },
    "total_score": {
      "type": "number"
    }
  },
  "required": [
    "patient_id",
    "outcome_measure_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "$and": [
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "clinic_admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "clinician"
                  }
                }
              ]
            },
            {
              "data.clinic_id": "{{user.data.clinic_id}}"
            }
          ]
        },
        {
          "data.patient_id": "{{user.data.patient_id}}"
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "clinic_admin"
              }
            },
            {
              "user_condition": {
                "role": "clinician"
              }
            }
          ]
        },
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "$and": [
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "clinic_admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "clinician"
                  }
                }
              ]
            },
            {
              "data.clinic_id": "{{user.data.clinic_id}}"
            }
          ]
        },
        {
          "data.patient_id": "{{user.data.patient_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "clinic_admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "clinician"
                  }
                }
              ]
            },
            {
              "data.clinic_id": "{{user.data.clinic_id}}"
            }
          ]
        },
        {
          "data.patient_id": "{{user.data.patient_id}}"
        }
      ]
    }
  },
  "type": "object"
}