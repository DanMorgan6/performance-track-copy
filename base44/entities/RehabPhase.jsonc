{
  "name": "RehabPhase",
  "type": "object",
  "properties": {
    "plan_id": {
      "type": "string",
      "description": "Reference to RehabPlan"
    },
    "phase_number": {
      "type": "number"
    },
    "name": {
      "type": "string",
      "description": "Phase name e.g. 'Acute Recovery'"
    },
    "description": {
      "type": "string"
    },
    "duration_weeks": {
      "type": "number"
    },
    "weeks": {
      "type": "array",
      "description": "Weekly schedule - single source of truth for plan delivery",
      "items": {
        "type": "object",
        "properties": {
          "week_number": {
            "type": "number"
          },
          "daily_schedule": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "day": {
                  "type": "string",
                  "enum": [
                    "Monday",
                    "Tuesday",
                    "Wednesday",
                    "Thursday",
                    "Friday",
                    "Saturday",
                    "Sunday"
                  ]
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "training",
                    "rest",
                    "conditioning"
                  ]
                },
                "exercises": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "description": {
                        "type": "string"
                      },
                      "sets": {
                        "type": "number"
                      },
                      "reps": {
                        "type": "string"
                      },
                      "weight": {
                        "type": "string"
                      },
                      "hold": {
                        "type": "string"
                      },
                      "tempo": {
                        "type": "string"
                      },
                      "duration": {
                        "type": "string"
                      },
                      "rest": {
                        "type": "string"
                      },
                      "rpe": {
                        "type": "string",
                        "description": "Rate of perceived exertion"
                      },
                      "notes": {
                        "type": "string",
                        "description": "Clinician notes/coaching cues"
                      },
                      "video_url": {
                        "type": "string"
                      },
                      "superset_group": {
                        "type": "string"
                      },
                      "superset_position": {
                        "type": "number"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "exit_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "criterion": {
            "type": "string"
          },
          "target_value": {
            "type": "string"
          },
          "is_met": {
            "type": "boolean"
          }
        }
      }
    },
    "exercises": {
      "type": "array",
      "description": "Legacy field - use weeks.daily_schedule for plan delivery",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "sets": {
            "type": "number"
          },
          "reps": {
            "type": "string"
          },
          "frequency": {
            "type": "string"
          },
          "video_url": {
            "type": "string"
          },
          "weight": {
            "type": [
              "number",
              "null"
            ]
          },
          "hold": {
            "type": [
              "string",
              "null"
            ]
          },
          "tempo": {
            "type": [
              "string",
              "null"
            ]
          },
          "duration": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "completed"
      ],
      "default": "pending"
    }
  },
  "required": [
    "plan_id",
    "phase_number",
    "name"
  ]
}