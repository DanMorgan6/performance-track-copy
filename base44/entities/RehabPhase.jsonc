{
  "name": "RehabPhase",
  "properties": {
    "clinic_id": {
      "description": "Reference to Clinic for tenant isolation",
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "duration_weeks": {
      "type": "number"
    },
    "exercises": {
      "description": "Legacy field - use weeks.daily_schedule for plan delivery",
      "items": {
        "properties": {
          "description": {
            "type": "string"
          },
          "duration": {
            "type": [
              "string",
              "null"
            ]
          },
          "frequency": {
            "type": "string"
          },
          "hold": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "reps": {
            "type": "string"
          },
          "sets": {
            "type": "number"
          },
          "tempo": {
            "type": [
              "string",
              "null"
            ]
          },
          "video_url": {
            "type": "string"
          },
          "weight": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "exit_criteria": {
      "items": {
        "properties": {
          "criterion": {
            "type": "string"
          },
          "is_met": {
            "type": "boolean"
          },
          "target_value": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "name": {
      "description": "Phase name e.g. 'Acute Recovery'",
      "type": "string"
    },
    "patient_id": {
      "description": "Reference to Patient for access control",
      "type": "string"
    },
    "phase_number": {
      "type": "number"
    },
    "plan_id": {
      "description": "Reference to RehabPlan",
      "type": "string"
    },
    "status": {
      "default": "pending",
      "enum": [
        "pending",
        "active",
        "completed"
      ],
      "type": "string"
    },
    "weeks": {
      "description": "Weekly schedule - single source of truth for plan delivery",
      "items": {
        "properties": {
          "daily_schedule": {
            "items": {
              "properties": {
                "day": {
                  "enum": [
                    "Monday",
                    "Tuesday",
                    "Wednesday",
                    "Thursday",
                    "Friday",
                    "Saturday",
                    "Sunday"
                  ],
                  "type": "string"
                },
                "exercises": {
                  "items": {
                    "properties": {
                      "description": {
                        "type": "string"
                      },
                      "duration": {
                        "type": "string"
                      },
                      "hold": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "notes": {
                        "description": "Clinician notes/coaching cues",
                        "type": "string"
                      },
                      "reps": {
                        "type": "string"
                      },
                      "rest": {
                        "type": "string"
                      },
                      "rpe": {
                        "description": "Rate of perceived exertion",
                        "type": "string"
                      },
                      "sets": {
                        "type": "number"
                      },
                      "superset_group": {
                        "type": "string"
                      },
                      "superset_position": {
                        "type": "number"
                      },
                      "tempo": {
                        "type": "string"
                      },
                      "video_url": {
                        "type": "string"
                      },
                      "weight": {
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  "type": "array"
                },
                "type": {
                  "enum": [
                    "training",
                    "rest",
                    "conditioning"
                  ],
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "week_number": {
            "type": "number"
          }
        },
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "plan_id",
    "phase_number",
    "name"
  ],
  "type": "object"
}