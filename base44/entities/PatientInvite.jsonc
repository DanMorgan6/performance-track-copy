{
  "name": "PatientInvite",
  "type": "object",
  "properties": {
    "clinic_id": {
      "type": "string",
      "description": "Reference to Clinic"
    },
    "patient_email": {
      "type": "string",
      "description": "Patient email address"
    },
    "invite_code": {
      "type": "string",
      "description": "Unique short code for patient to use"
    },
    "full_name": {
      "type": "string",
      "description": "Patient name (pre-filled by clinician)"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date"
    },
    "injury_type": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "accepted",
        "expired"
      ],
      "default": "active"
    },
    "accepted_date": {
      "type": "string",
      "format": "date"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by_clinician": {
      "type": "string",
      "description": "Email of clinician who created invite"
    }
  },
  "required": [
    "clinic_id",
    "invite_code"
  ]
}