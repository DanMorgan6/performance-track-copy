{
  "name": "PatientInvite",
  "properties": {
    "accepted_date": {
      "format": "date",
      "type": "string"
    },
    "clinic_id": {
      "description": "Reference to Clinic",
      "type": "string"
    },
    "created_by_clinician": {
      "description": "Email of clinician who created invite",
      "type": "string"
    },
    "date_of_birth": {
      "format": "date",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "type": "string"
    },
    "full_name": {
      "description": "Patient name (pre-filled by clinician)",
      "type": "string"
    },
    "injury_type": {
      "type": "string"
    },
    "invite_code": {
      "description": "Unique short code for patient to use",
      "type": "string"
    },
    "patient_email": {
      "description": "Patient email address",
      "type": "string"
    },
    "status": {
      "default": "active",
      "enum": [
        "active",
        "accepted",
        "expired"
      ],
      "type": "string"
    }
  },
  "required": [
    "clinic_id",
    "invite_code"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "clinic_admin"
              }
            }
          ]
        },
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "clinic_admin"
              }
            }
          ]
        },
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "$and": [
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "clinic_admin"
                  }
                }
              ]
            },
            {
              "data.clinic_id": "{{user.data.clinic_id}}"
            }
          ]
        },
        {
          "data.patient_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "clinic_admin"
                  }
                }
              ]
            },
            {
              "data.clinic_id": "{{user.data.clinic_id}}"
            }
          ]
        },
        {
          "data.patient_email": "{{user.email}}"
        }
      ]
    }
  },
  "type": "object"
}