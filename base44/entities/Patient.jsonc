{
  "name": "Patient",
  "type": "object",
  "properties": {
    "clinic_id": {
      "type": "string",
      "description": "Reference to Clinic"
    },
    "user_id": {
      "type": "string",
      "description": "Reference to User (linked when patient accepts invite)"
    },
    "full_name": {
      "type": "string",
      "description": "Patient's full name"
    },
    "email": {
      "type": "string",
      "description": "Patient's email address"
    },
    "gender": {
      "type": "string",
      "enum": [
        "male",
        "female",
        "other"
      ],
      "description": "Patient's gender for body diagram display"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date"
    },
    "phone": {
      "type": "string"
    },
    "injury_type": {
      "type": "string",
      "description": "Primary injury or condition"
    },
    "injury_date": {
      "type": "string",
      "format": "date"
    },
    "assigned_coach": {
      "type": "string",
      "description": "Email of assigned coach"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "invited",
        "active",
        "completed",
        "paused",
        "discharged"
      ],
      "default": "invited",
      "description": "Patient status"
    },
    "portal_access_sent": {
      "type": "boolean",
      "default": false
    },
    "portal_access_sent_date": {
      "type": "string",
      "format": "date"
    },
    "messaging_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether the clinician has enabled in-app messaging for this patient"
    }
  },
  "required": [
    "clinic_id",
    "full_name",
    "email"
  ]
}