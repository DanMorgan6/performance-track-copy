{
  "name": "Patient",
  "properties": {
    "assigned_coach": {
      "description": "Email of assigned coach",
      "type": "string"
    },
    "clinic_id": {
      "description": "Reference to Clinic",
      "type": "string"
    },
    "date_of_birth": {
      "format": "date",
      "type": "string"
    },
    "email": {
      "description": "Patient's email address",
      "type": "string"
    },
    "full_name": {
      "description": "Patient's full name",
      "type": "string"
    },
    "gender": {
      "description": "Patient's gender for body diagram display",
      "enum": [
        "male",
        "female",
        "other"
      ],
      "type": "string"
    },
    "injury_date": {
      "format": "date",
      "type": "string"
    },
    "injury_type": {
      "description": "Primary injury or condition",
      "type": "string"
    },
    "medical_conditions": {
      "description": "Comorbidities and relevant medical conditions (ever-changing)",
      "type": "string"
    },
    "medications": {
      "description": "Current medications and dosage notes (updated as they change)",
      "type": "string"
    },
    "messaging_enabled": {
      "default": false,
      "description": "Whether the clinician has enabled in-app messaging for this patient",
      "type": "boolean"
    },
    "notes": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "portal_access_sent": {
      "default": false,
      "type": "boolean"
    },
    "portal_access_sent_date": {
      "format": "date",
      "type": "string"
    },
    "status": {
      "default": "invited",
      "description": "Patient status",
      "enum": [
        "invited",
        "active",
        "completed",
        "paused",
        "discharged"
      ],
      "type": "string"
    },
    "user_id": {
      "description": "Reference to User (linked when patient accepts invite)",
      "type": "string"
    }
  },
  "required": [
    "clinic_id",
    "full_name",
    "email"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "clinic_admin"
              }
            },
            {
              "user_condition": {
                "role": "clinician"
              }
            }
          ]
        },
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "clinic_admin"
              }
            },
            {
              "user_condition": {
                "role": "clinician"
              }
            }
          ]
        },
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "$and": [
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "clinic_admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "clinician"
                  }
                }
              ]
            },
            {
              "data.clinic_id": "{{user.data.clinic_id}}"
            }
          ]
        },
        {
          "data.email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "clinic_admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "clinician"
                  }
                }
              ]
            },
            {
              "data.clinic_id": "{{user.data.clinic_id}}"
            }
          ]
        },
        {
          "data.email": "{{user.email}}"
        }
      ]
    }
  },
  "type": "object"
}