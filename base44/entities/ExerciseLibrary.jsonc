{
  "name": "ExerciseLibrary",
  "properties": {
    "body_part": {
      "enum": [
        "upper_body",
        "lower_body",
        "core",
        "full_body",
        "shoulder",
        "knee",
        "hip",
        "ankle",
        "back",
        "neck"
      ],
      "type": "string"
    },
    "category": {
      "enum": [
        "strength",
        "flexibility",
        "balance",
        "cardiovascular",
        "mobility",
        "stability",
        "coordination",
        "plyometric",
        "functional"
      ],
      "type": "string"
    },
    "clinic_id": {
      "description": "Owning clinic; exercises are private to the clinic",
      "type": "string"
    },
    "default_frequency": {
      "description": "Deprecated - frequency should be specified in plan/phase, not globally",
      "type": "string"
    },
    "default_reps": {
      "default": "10",
      "type": "string"
    },
    "default_sets": {
      "default": 3,
      "type": "number"
    },
    "description": {
      "description": "Detailed instructions",
      "type": "string"
    },
    "difficulty_level": {
      "default": "beginner",
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ],
      "type": "string"
    },
    "equipment_needed": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "name": {
      "description": "Exercise name",
      "type": "string"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "thumbnail_url": {
      "type": "string"
    },
    "video_url": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "clinic_admin"
              }
            },
            {
              "user_condition": {
                "role": "clinician"
              }
            }
          ]
        },
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "clinic_admin"
              }
            },
            {
              "user_condition": {
                "role": "clinician"
              }
            }
          ]
        },
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        }
      ]
    },
    "read": {
      "data.clinic_id": "{{user.data.clinic_id}}"
    },
    "update": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "clinic_admin"
              }
            },
            {
              "user_condition": {
                "role": "clinician"
              }
            }
          ]
        },
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        }
      ]
    }
  },
  "type": "object"
}