{
  "name": "InviteToken",
  "properties": {
    "clinic_id": {
      "description": "Reference to Clinic",
      "type": "string"
    },
    "created_by": {
      "description": "Email of user who created the invite",
      "type": "string"
    },
    "email": {
      "description": "Email of invited user",
      "type": "string"
    },
    "expires_at": {
      "description": "Token expiration timestamp",
      "format": "date-time",
      "type": "string"
    },
    "invite_type": {
      "description": "Type of invite",
      "enum": [
        "clinician",
        "patient"
      ],
      "type": "string"
    },
    "patient_id": {
      "description": "Reference to Patient (for patient invites only)",
      "type": "string"
    },
    "revoked_at": {
      "description": "When token was revoked/superseded",
      "format": "date-time",
      "type": "string"
    },
    "role_target": {
      "default": "clinician",
      "description": "Target role to assign on acceptance",
      "enum": [
        "clinician",
        "clinic_admin",
        "admin",
        "patient"
      ],
      "type": "string"
    },
    "status": {
      "default": "active",
      "description": "Current status of token",
      "enum": [
        "active",
        "used",
        "expired",
        "revoked"
      ],
      "type": "string"
    },
    "token": {
      "description": "Signed/opaque token (unique, URL-safe)",
      "type": "string"
    },
    "used_at": {
      "description": "When token was redeemed",
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "clinic_id",
    "token",
    "invite_type",
    "email",
    "expires_at"
  ],
  "type": "object"
}