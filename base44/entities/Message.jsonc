{
  "name": "Message",
  "type": "object",
  "properties": {
    "patient_id": {
      "type": "string",
      "description": "Reference to Patient"
    },
    "clinic_id": {
      "type": "string",
      "description": "Reference to Clinic for isolation"
    },
    "sender_role": {
      "type": "string",
      "enum": [
        "clinician",
        "patient"
      ],
      "description": "Who sent this message"
    },
    "sender_name": {
      "type": "string",
      "description": "Display name of sender"
    },
    "content": {
      "type": "string",
      "description": "Message text content"
    },
    "read_by_clinician": {
      "type": "boolean",
      "default": false
    },
    "read_by_patient": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "patient_id",
    "clinic_id",
    "sender_role",
    "content"
  ]
}