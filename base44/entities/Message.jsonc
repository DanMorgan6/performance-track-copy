{
  "name": "Message",
  "properties": {
    "clinic_id": {
      "description": "Reference to Clinic for isolation",
      "type": "string"
    },
    "content": {
      "description": "Message text content",
      "type": "string"
    },
    "patient_id": {
      "description": "Reference to Patient",
      "type": "string"
    },
    "read_by_clinician": {
      "default": false,
      "type": "boolean"
    },
    "read_by_patient": {
      "default": false,
      "type": "boolean"
    },
    "sender_name": {
      "description": "Display name of sender",
      "type": "string"
    },
    "sender_role": {
      "description": "Who sent this message",
      "enum": [
        "clinician",
        "patient"
      ],
      "type": "string"
    }
  },
  "required": [
    "patient_id",
    "clinic_id",
    "sender_role",
    "content"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "$and": [
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "clinic_admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "clinician"
                  }
                }
              ]
            },
            {
              "data.clinic_id": "{{user.data.clinic_id}}"
            }
          ]
        },
        {
          "data.patient_id": "{{user.data.patient_id}}"
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "clinic_admin"
              }
            },
            {
              "user_condition": {
                "role": "clinician"
              }
            }
          ]
        },
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "$and": [
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "clinic_admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "clinician"
                  }
                }
              ]
            },
            {
              "data.clinic_id": "{{user.data.clinic_id}}"
            }
          ]
        },
        {
          "data.patient_id": "{{user.data.patient_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "clinic_admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "clinician"
                  }
                }
              ]
            },
            {
              "data.clinic_id": "{{user.data.clinic_id}}"
            }
          ]
        },
        {
          "data.patient_id": "{{user.data.patient_id}}"
        }
      ]
    }
  },
  "type": "object"
}