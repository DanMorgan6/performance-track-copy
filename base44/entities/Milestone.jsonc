{
  "name": "Milestone",
  "properties": {
    "clinic_id": {
      "description": "Reference to Clinic - required for multi-clinic isolation",
      "type": "string"
    },
    "created_by": {
      "type": "string"
    },
    "date": {
      "description": "Date of the milestone",
      "format": "date",
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "outcomes_published": {
      "default": false,
      "description": "Whether outcomes are visible to patient",
      "type": "boolean"
    },
    "patient_id": {
      "description": "Reference to Patient",
      "type": "string"
    },
    "plan_id": {
      "description": "Reference to RehabPlan",
      "type": "string"
    },
    "tests": {
      "description": "Planned tests for this milestone",
      "items": {
        "properties": {
          "category": {
            "type": "string"
          },
          "expected_benchmark": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "outcome_notes": {
            "type": "string"
          },
          "outcome_status": {
            "enum": [
              "pending",
              "pass",
              "fail",
              "partial"
            ],
            "type": "string"
          },
          "outcome_unit": {
            "type": "string"
          },
          "outcome_value": {
            "type": "string"
          },
          "test_name": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "title": {
      "description": "Milestone title",
      "type": "string"
    },
    "type": {
      "default": "testing",
      "description": "Type of milestone",
      "enum": [
        "testing"
      ],
      "type": "string"
    }
  },
  "required": [
    "clinic_id",
    "patient_id",
    "plan_id",
    "date",
    "type"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "clinic_admin"
              }
            },
            {
              "user_condition": {
                "role": "clinician"
              }
            }
          ]
        },
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "clinic_admin"
              }
            },
            {
              "user_condition": {
                "role": "clinician"
              }
            }
          ]
        },
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "$and": [
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "clinic_admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "clinician"
                  }
                }
              ]
            },
            {
              "data.clinic_id": "{{user.data.clinic_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "data.patient_id": "{{user.data.patient_id}}"
            },
            {
              "data.clinic_id": "{{user.data.clinic_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "clinic_admin"
              }
            },
            {
              "user_condition": {
                "role": "clinician"
              }
            }
          ]
        },
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        }
      ]
    }
  },
  "type": "object"
}