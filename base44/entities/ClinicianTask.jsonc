{
  "name": "ClinicianTask",
  "properties": {
    "assigned_by": {
      "description": "Email of clinician who created task",
      "type": "string"
    },
    "assigned_to": {
      "description": "Email of assigned clinician",
      "type": "string"
    },
    "auto_generated": {
      "default": false,
      "description": "Whether this task was automatically created by the system",
      "type": "boolean"
    },
    "clinic_id": {
      "description": "Reference to Clinic for tenant isolation",
      "type": "string"
    },
    "completed_date": {
      "format": "date",
      "type": "string"
    },
    "description": {
      "description": "Task details",
      "type": "string"
    },
    "due_date": {
      "format": "date",
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "patient_id": {
      "description": "Reference to Patient",
      "type": "string"
    },
    "priority": {
      "default": "medium",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "type": "string"
    },
    "status": {
      "default": "pending",
      "enum": [
        "pending",
        "in_progress",
        "completed"
      ],
      "type": "string"
    },
    "task_type": {
      "default": "other",
      "enum": [
        "follow_up_call",
        "review_progress",
        "adjust_plan",
        "assessment_needed",
        "consultation",
        "other"
      ],
      "type": "string"
    },
    "title": {
      "description": "Task title",
      "type": "string"
    },
    "trigger_reason": {
      "description": "Why this task was auto-generated (e.g., 'Low adherence detected')",
      "type": "string"
    }
  },
  "required": [
    "patient_id",
    "assigned_to",
    "title"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "clinic_admin"
              }
            },
            {
              "user_condition": {
                "role": "clinician"
              }
            }
          ]
        },
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "clinic_admin"
              }
            },
            {
              "user_condition": {
                "role": "clinician"
              }
            }
          ]
        },
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        }
      ]
    },
    "read": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "clinic_admin"
              }
            },
            {
              "user_condition": {
                "role": "clinician"
              }
            }
          ]
        },
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        }
      ]
    },
    "update": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "clinic_admin"
              }
            },
            {
              "user_condition": {
                "role": "clinician"
              }
            }
          ]
        },
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        }
      ]
    }
  },
  "type": "object"
}