{
  "name": "PhaseOutcomeTrigger",
  "properties": {
    "clinic_id": {
      "description": "Reference to Clinic for tenant isolation",
      "type": "string"
    },
    "outcome_measure_id": {
      "description": "Reference to OutcomeMeasure to send",
      "type": "string"
    },
    "patient_id": {
      "description": "Reference to Patient for access control",
      "type": "string"
    },
    "phase_number": {
      "description": "Phase number to trigger on",
      "type": "number"
    },
    "plan_id": {
      "description": "Reference to RehabPlan",
      "type": "string"
    },
    "trigger_type": {
      "default": "phase_complete",
      "description": "When to send the outcome measure",
      "enum": [
        "phase_start",
        "phase_complete"
      ],
      "type": "string"
    },
    "triggered": {
      "default": false,
      "description": "Whether this trigger has been executed",
      "type": "boolean"
    },
    "triggered_date": {
      "format": "date",
      "type": "string"
    }
  },
  "required": [
    "plan_id",
    "phase_number",
    "outcome_measure_id"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "clinic_admin"
              }
            },
            {
              "user_condition": {
                "role": "clinician"
              }
            }
          ]
        },
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "clinic_admin"
              }
            },
            {
              "user_condition": {
                "role": "clinician"
              }
            }
          ]
        },
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        }
      ]
    },
    "read": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "clinic_admin"
              }
            },
            {
              "user_condition": {
                "role": "clinician"
              }
            }
          ]
        },
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        }
      ]
    },
    "update": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "clinic_admin"
              }
            },
            {
              "user_condition": {
                "role": "clinician"
              }
            }
          ]
        },
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        }
      ]
    }
  },
  "type": "object"
}