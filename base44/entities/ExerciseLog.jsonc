{
  "name": "ExerciseLog",
  "properties": {
    "clinic_id": {
      "description": "Reference to Clinic for tenant isolation",
      "type": "string"
    },
    "completed": {
      "default": false,
      "type": "boolean"
    },
    "date": {
      "format": "date",
      "type": "string"
    },
    "difficulty": {
      "enum": [
        "too_easy",
        "appropriate",
        "challenging",
        "too_hard"
      ],
      "type": "string"
    },
    "exercise_name": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "pain_after": {
      "description": "Pain level after exercise 0-10",
      "type": "number"
    },
    "pain_during": {
      "description": "Pain level during exercise 0-10",
      "type": "number"
    },
    "patient_id": {
      "type": "string"
    },
    "phase_id": {
      "type": "string"
    },
    "reps_completed": {
      "type": "string"
    },
    "sets_completed": {
      "type": "number"
    },
    "weight": {
      "description": "Weight used in kg or lbs",
      "type": "number"
    }
  },
  "required": [
    "patient_id",
    "date",
    "exercise_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "$and": [
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "clinic_admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "clinician"
                  }
                }
              ]
            },
            {
              "data.clinic_id": "{{user.data.clinic_id}}"
            }
          ]
        },
        {
          "data.patient_id": "{{user.data.patient_id}}"
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "clinic_admin"
              }
            },
            {
              "user_condition": {
                "role": "clinician"
              }
            }
          ]
        },
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "$and": [
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "clinic_admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "clinician"
                  }
                }
              ]
            },
            {
              "data.clinic_id": "{{user.data.clinic_id}}"
            }
          ]
        },
        {
          "data.patient_id": "{{user.data.patient_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "clinic_admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "clinician"
                  }
                }
              ]
            },
            {
              "data.clinic_id": "{{user.data.clinic_id}}"
            }
          ]
        },
        {
          "data.patient_id": "{{user.data.patient_id}}"
        }
      ]
    }
  },
  "type": "object"
}