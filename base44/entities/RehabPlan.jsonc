{
  "name": "RehabPlan",
  "properties": {
    "basic_config": {
      "description": "Configuration for Basic programs only",
      "properties": {
        "days_of_week_pattern": {
          "description": "Days when exercises are scheduled",
          "items": {
            "enum": [
              "Monday",
              "Tuesday",
              "Wednesday",
              "Thursday",
              "Friday",
              "Saturday",
              "Sunday"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "exercise_bundle": {
          "description": "List of exercises with per-exercise prescription",
          "items": {
            "properties": {
              "description": {
                "type": "string"
              },
              "hold": {
                "type": "string"
              },
              "load_notes": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "reps": {
                "type": "string"
              },
              "rest": {
                "type": "string"
              },
              "sets": {
                "type": "number"
              },
              "tempo": {
                "type": "string"
              },
              "video_url": {
                "type": "string"
              },
              "weight": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "type": "array"
        },
        "frequency_per_week": {
          "description": "2, 3, 4, or 7 (daily)",
          "type": "number"
        },
        "weekend_rest_days": {
          "default": true,
          "description": "If true, Sat & Sun are rest days",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "clinic_id": {
      "description": "Reference to Clinic - required for multi-clinic isolation",
      "type": "string"
    },
    "created_by_clinician": {
      "type": "string"
    },
    "current_phase": {
      "default": 1,
      "type": "number"
    },
    "description": {
      "type": "string"
    },
    "patient_id": {
      "description": "Reference to Patient",
      "type": "string"
    },
    "program_type": {
      "default": "phased",
      "description": "Basic = simple recurring bundle; Phased = multi-phase progression",
      "enum": [
        "basic",
        "phased"
      ],
      "type": "string"
    },
    "start_date": {
      "format": "date",
      "type": "string"
    },
    "status": {
      "default": "active",
      "enum": [
        "draft",
        "active",
        "completed",
        "paused",
        "archived"
      ],
      "type": "string"
    },
    "target_end_date": {
      "format": "date",
      "type": "string"
    },
    "title": {
      "description": "Plan title",
      "type": "string"
    },
    "total_phases": {
      "type": "number"
    }
  },
  "required": [
    "clinic_id",
    "patient_id",
    "title"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "clinic_admin"
              }
            },
            {
              "user_condition": {
                "role": "clinician"
              }
            }
          ]
        },
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "clinic_admin"
              }
            },
            {
              "user_condition": {
                "role": "clinician"
              }
            }
          ]
        },
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "$and": [
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "clinic_admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "clinician"
                  }
                }
              ]
            },
            {
              "data.clinic_id": "{{user.data.clinic_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "data.patient_id": "{{user.data.patient_id}}"
            },
            {
              "data.clinic_id": "{{user.data.clinic_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "clinic_admin"
              }
            },
            {
              "user_condition": {
                "role": "clinician"
              }
            }
          ]
        },
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        }
      ]
    }
  },
  "type": "object"
}