{
  "name": "OutcomeMeasure",
  "properties": {
    "clinic_id": {
      "description": "Owning clinic; measures are private to the clinic",
      "type": "string"
    },
    "condition": {
      "description": "Condition this measure is for",
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "interpretation_guide": {
      "description": "How to interpret the scores",
      "type": "string"
    },
    "name": {
      "description": "Name of the outcome measure",
      "type": "string"
    },
    "questions": {
      "items": {
        "properties": {
          "options": {
            "items": {
              "properties": {
                "label": {
                  "type": "string"
                },
                "score": {
                  "type": "number"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "question": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "total_score_max": {
      "description": "Maximum possible score",
      "type": "number"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "clinic_admin"
              }
            },
            {
              "user_condition": {
                "role": "clinician"
              }
            }
          ]
        },
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "clinic_admin"
              }
            },
            {
              "user_condition": {
                "role": "clinician"
              }
            }
          ]
        },
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        }
      ]
    },
    "read": {
      "data.clinic_id": "{{user.data.clinic_id}}"
    },
    "update": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "clinic_admin"
              }
            },
            {
              "user_condition": {
                "role": "clinician"
              }
            }
          ]
        },
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        }
      ]
    }
  },
  "type": "object"
}