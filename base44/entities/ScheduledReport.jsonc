{
  "name": "ScheduledReport",
  "properties": {
    "active": {
      "default": true,
      "type": "boolean"
    },
    "clinic_id": {
      "description": "Reference to Clinic for tenant isolation",
      "type": "string"
    },
    "clinician_email": {
      "description": "Email of clinician who scheduled the report",
      "type": "string"
    },
    "frequency": {
      "default": "weekly",
      "enum": [
        "weekly",
        "bi-weekly",
        "monthly"
      ],
      "type": "string"
    },
    "include_sections": {
      "description": "Sections to include: progress, assessments, outcomes, pain, exercises, interventions",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "last_generated_date": {
      "format": "date",
      "type": "string"
    },
    "next_generation_date": {
      "format": "date",
      "type": "string"
    },
    "patient_id": {
      "description": "Reference to Patient",
      "type": "string"
    },
    "report_name": {
      "description": "Name of the report",
      "type": "string"
    },
    "send_to_email": {
      "description": "Email to send report to",
      "type": "string"
    }
  },
  "required": [
    "patient_id",
    "clinician_email",
    "report_name",
    "frequency"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "clinic_admin"
              }
            },
            {
              "user_condition": {
                "role": "clinician"
              }
            }
          ]
        },
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "clinic_admin"
              }
            },
            {
              "user_condition": {
                "role": "clinician"
              }
            }
          ]
        },
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        }
      ]
    },
    "read": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "clinic_admin"
              }
            },
            {
              "user_condition": {
                "role": "clinician"
              }
            }
          ]
        },
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        }
      ]
    },
    "update": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "clinic_admin"
              }
            },
            {
              "user_condition": {
                "role": "clinician"
              }
            }
          ]
        },
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        }
      ]
    }
  },
  "type": "object"
}