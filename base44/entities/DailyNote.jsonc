{
  "name": "DailyNote",
  "properties": {
    "adherence_self_rating": {
      "description": "Self-rated adherence 1-10",
      "type": "number"
    },
    "clinic_id": {
      "description": "Reference to Clinic for tenant isolation",
      "type": "string"
    },
    "date": {
      "format": "date",
      "type": "string"
    },
    "energy_level": {
      "description": "Energy level 1-10",
      "type": "number"
    },
    "major_win": {
      "description": "Patient's major win for the week",
      "type": "string"
    },
    "mood": {
      "description": "Overall mood/feeling",
      "enum": [
        "great",
        "good",
        "okay",
        "struggling",
        "difficult"
      ],
      "type": "string"
    },
    "notes": {
      "description": "Subjective feedback and observations",
      "type": "string"
    },
    "patient_id": {
      "description": "Reference to Patient",
      "type": "string"
    },
    "sleep_quality": {
      "description": "Sleep quality",
      "enum": [
        "excellent",
        "good",
        "fair",
        "poor"
      ],
      "type": "string"
    }
  },
  "required": [
    "patient_id",
    "date"
  ],
  "type": "object"
}