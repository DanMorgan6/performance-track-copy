{
  "name": "RehabTemplate",
  "properties": {
    "clinic_id": {
      "description": "Owning clinic; templates are private to the clinic",
      "type": "string"
    },
    "condition_type": {
      "description": "e.g., ACL Recovery, Rotator Cuff, Lower Back Pain",
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "estimated_duration_weeks": {
      "type": "number"
    },
    "is_public": {
      "default": false,
      "description": "Whether this template is shared with other clinicians",
      "type": "boolean"
    },
    "name": {
      "description": "Template name",
      "type": "string"
    },
    "phases": {
      "items": {
        "properties": {
          "description": {
            "type": "string"
          },
          "duration_weeks": {
            "type": "number"
          },
          "exercises": {
            "items": {
              "properties": {
                "description": {
                  "type": "string"
                },
                "frequency": {
                  "type": "string"
                },
                "library_exercise_id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "reps": {
                  "type": "string"
                },
                "sets": {
                  "type": "number"
                },
                "video_url": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "exit_criteria": {
            "items": {
              "properties": {
                "criterion": {
                  "type": "string"
                },
                "is_met": {
                  "type": "boolean"
                },
                "target_value": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "name": {
            "type": "string"
          },
          "phase_number": {
            "type": "number"
          },
          "weeks": {
            "items": {
              "properties": {
                "daily_schedule": {
                  "items": {
                    "properties": {
                      "blocks": {
                        "items": {
                          "properties": {
                            "exercises": {
                              "items": {
                                "properties": {
                                  "duration": {
                                    "type": "string"
                                  },
                                  "hold": {
                                    "type": "string"
                                  },
                                  "name": {
                                    "type": "string"
                                  },
                                  "notes": {
                                    "type": "string"
                                  },
                                  "reps": {
                                    "type": "string"
                                  },
                                  "rest": {
                                    "type": "string"
                                  },
                                  "rpe": {
                                    "type": "string"
                                  },
                                  "sets": {
                                    "type": "string"
                                  },
                                  "tempo": {
                                    "type": "string"
                                  },
                                  "video_url": {
                                    "type": "string"
                                  },
                                  "weight": {
                                    "type": "string"
                                  }
                                },
                                "type": "object"
                              },
                              "type": "array"
                            },
                            "note": {
                              "type": "string"
                            },
                            "rest_after": {
                              "type": "string"
                            },
                            "rounds": {
                              "type": "string"
                            },
                            "type": {
                              "type": "string"
                            }
                          },
                          "type": "object"
                        },
                        "type": "array"
                      },
                      "day": {
                        "type": "string"
                      },
                      "duration": {
                        "type": "string"
                      },
                      "emphasis": {
                        "type": "string"
                      },
                      "exercises": {
                        "items": {
                          "properties": {
                            "description": {
                              "type": "string"
                            },
                            "duration": {
                              "type": "string"
                            },
                            "hold": {
                              "type": "string"
                            },
                            "name": {
                              "type": "string"
                            },
                            "notes": {
                              "type": "string"
                            },
                            "reps": {
                              "type": "string"
                            },
                            "rest": {
                              "type": "string"
                            },
                            "rpe": {
                              "type": "string"
                            },
                            "sets": {
                              "type": "number"
                            },
                            "tempo": {
                              "type": "string"
                            },
                            "video_url": {
                              "type": "string"
                            },
                            "weight": {
                              "type": "string"
                            }
                          },
                          "type": "object"
                        },
                        "type": "array"
                      },
                      "load_target": {
                        "type": "string"
                      },
                      "session_note": {
                        "type": "string"
                      },
                      "session_title": {
                        "type": "string"
                      },
                      "type": {
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  "type": "array"
                },
                "week_number": {
                  "type": "number"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "total_phases": {
      "type": "number"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "clinic_admin"
              }
            },
            {
              "user_condition": {
                "role": "clinician"
              }
            }
          ]
        },
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "clinic_admin"
              }
            },
            {
              "user_condition": {
                "role": "clinician"
              }
            }
          ]
        },
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        }
      ]
    },
    "read": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "clinic_admin"
              }
            },
            {
              "user_condition": {
                "role": "clinician"
              }
            }
          ]
        },
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        }
      ]
    },
    "update": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "clinic_admin"
              }
            },
            {
              "user_condition": {
                "role": "clinician"
              }
            }
          ]
        },
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        }
      ]
    }
  },
  "type": "object"
}