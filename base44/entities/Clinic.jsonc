{
  "name": "Clinic",
  "properties": {
    "address": {
      "type": "string"
    },
    "booking_url": {
      "description": "Default clinic-wide booking/appointment link",
      "type": "string"
    },
    "brand_color_primary": {
      "default": "#9333ea",
      "description": "Primary brand color (hex)",
      "type": "string"
    },
    "brand_color_secondary": {
      "default": "#06b6d4",
      "description": "Secondary brand color (hex)",
      "type": "string"
    },
    "clinic_id": {
      "description": "Tenant identifier; equal to the Clinic record id",
      "type": "string",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "clinician_seat_count": {
      "default": 0,
      "description": "Number of active clinicians (seats)",
      "type": "number",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "contact_email": {
      "description": "Main contact email",
      "type": "string"
    },
    "current_period_end": {
      "description": "Current billing period end date",
      "format": "date-time",
      "type": "string",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "current_period_start": {
      "description": "Current billing period start",
      "format": "date-time",
      "type": "string",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "logo_url": {
      "description": "Clinic logo image URL",
      "type": "string"
    },
    "monthly_price_pence": {
      "default": 0,
      "description": "Monthly subscription price in pence: 3000 for 0-5 practitioners, 4500 for 6-10 practitioners",
      "type": "number",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "name": {
      "description": "Clinic name",
      "type": "string"
    },
    "owner_email": {
      "description": "Clinic owner/admin email",
      "type": "string",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "phone": {
      "type": "string"
    },
    "stripe_customer_id": {
      "description": "Stripe customer ID",
      "type": "string",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "stripe_subscription_id": {
      "description": "Stripe subscription ID",
      "type": "string",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "subscription_status": {
      "default": "trialing",
      "description": "Subscription status from Stripe",
      "enum": [
        "trial",
        "trialing",
        "active",
        "past_due",
        "unpaid",
        "canceled",
        "incomplete"
      ],
      "type": "string",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "trial_end_date": {
      "description": "Trial end date (14 days after start)",
      "format": "date-time",
      "type": "string",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "trial_start_date": {
      "description": "Trial start date",
      "format": "date-time",
      "type": "string",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    }
  },
  "required": [
    "name",
    "contact_email",
    "owner_email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.clinic_id": "{{user.data.clinic_id}}"
        },
        {
          "data.owner_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "clinic_admin"
                  }
                }
              ]
            },
            {
              "data.clinic_id": "{{user.data.clinic_id}}"
            }
          ]
        },
        {
          "data.owner_email": "{{user.email}}"
        }
      ]
    }
  },
  "type": "object"
}